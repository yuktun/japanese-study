rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validProgress() {
      return request.resource.data.keys().hasOnly(['schemaVersion','cardId','status','bookmarked','lastReviewed','updatedAt'])
        && request.resource.data.keys().hasAll(['schemaVersion','cardId','status','bookmarked','lastReviewed','updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.cardId is string
        && request.resource.data.cardId.size() > 0 && request.resource.data.cardId.size() <= 160
        && (request.resource.data.status == null || request.resource.data.status in ['correct','incorrect'])
        && request.resource.data.bookmarked is bool
        && (request.resource.data.lastReviewed == null || request.resource.data.lastReviewed is string)
        && (request.resource.data.lastReviewed == null || request.resource.data.lastReviewed.size() <= 40)
        && request.resource.data.updatedAt is timestamp;
    }
    match /users/{uid}/progress/{cardId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validProgress();
      allow delete: if false;
    }
  }
}
