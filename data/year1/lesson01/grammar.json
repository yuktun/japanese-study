  {
    "id": "y1-l01-g006",
    "schoolYear": 1,
    "book": "初級 I",
    "lesson": 1,
    "pattern": "N は QW ですか",
    "meaningZh": "N 是誰／幾歲呢？",
    "explanationZh": "將適當疑問詞放進想知道的內容部分。",
    "notes": [
      "這類提問不用「はい／いいえ」回答。"
    ],
    "examples": [
      {
        "ja": "あの方はどなたですか。",
        "zh": "那位先生是誰呀？"
      },
      {
        "ja": "イーさんは何歳／おいくつですか。",
        "zh": "李小姐多大年紀了？"
      }
    ],
