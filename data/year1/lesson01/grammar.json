  },
  {
    "id": "y1-l01-g002",
    "schoolYear": 1,
    "book": "初級 I",
    "lesson": 1,
    "pattern": "N1 は N2 です",
    "meaningZh": "N1 是 N2。",
    "explanationZh": "「は」表示句子主題；「です」放於名詞句最後表示肯定，屬禮貌文體。",
    "notes": [
      "「は」作助詞時讀作「わ」。"
    ],
    "examples": [
      {
        "ja": "わたしはマイク・ミラーです。",
        "zh": "我是邁克・米勒。"
      },
      {
        "ja": "ワンさんは中国人です。",
        "zh": "小王是中國人。"
      }
    ],
    "source": {
      "type": "school_pdf",
      "driveFileId": "1PweBWor5p4cWSmt8ueXK_qIatt24-Bzq",
      "fileName": "g_1_01.pdf"
    }
  },
  {
    "id": "y1-l01-g003",
    "schoolYear": 1,
    "book": "初級 I",
    "lesson": 1,
    "pattern": "N1 は N2 じゃありません",
    "meaningZh": "N1 不是 N2。",
    "explanationZh": "「じゃありません」是「です」的否定形，表示否定。",
    "notes": [
      "「じゃ」是「では」的縮約形；較正式可用「ではありません」。"
    ],
    "examples": [
      {
        "ja": "わたしは教師じゃありません。",
        "zh": "我不是教師。"
      }
    ],
    "source": {
      "type": "school_pdf",
      "driveFileId": "1PweBWor5p4cWSmt8ueXK_qIatt24-Bzq",
      "fileName": "g_1_01.pdf"
    }
  },
  {
    "id": "y1-l01-g004",
    "schoolYear": 1,
    "book": "初級 I",
    "lesson": 1,
    "pattern": "N1 は N2 ですか",
    "meaningZh": "N1 是 N2 嗎？",
    "explanationZh": "句末助詞「か」表示疑問。",
    "notes": [
      "一般疑問句可用「はい／いいえ」回答。"
    ],
    "examples": [
      {
        "ja": "山田さんは銀行員ですか。",
        "zh": "山田先生是銀行職員嗎？"
      }
    ],
    "source": {
      "type": "school_pdf",
