[
  {
    "id": "y1-l01-g001",
    "schoolYear": 1,
    "book": "初級 I",
    "lesson": 1,
    "pattern": "N1 の N2",
    "meaningZh": "N1 的 N2",
    "explanationZh": "「の」是助詞，用前面的名詞 N1 修飾後面的名詞 N2，表示所屬。",
    "notes": [
      "助詞通常不能單獨使用。"
    ],
    "examples": [
      {
        "ja": "富士大学の学生",
        "zh": "富士大學的學生"
      },
      {
        "ja": "桜大学の先生",
        "zh": "櫻花大學的老師"
      },
      {
        "ja": "神戸病院の医者",
        "zh": "神戶醫院的醫生"
      },
      {
        "ja": "IMCの社員",
        "zh": "IMC 的職員"
      }
    ],
    "source": {
      "type": "school_pdf",
      "driveFileId": "1PweBWor5p4cWSmt8ueXK_qIatt24-Bzq",
      "fileName": "g_1_01.pdf"
