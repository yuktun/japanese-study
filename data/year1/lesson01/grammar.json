      "fileName": "g_1_01.pdf"
    }
  },
  {
    "id": "y1-l01-g005",
    "schoolYear": 1,
    "book": "初級 I",
    "lesson": 1,
    "pattern": "N1 も N2 です",
    "meaningZh": "N1 也是 N2。",
    "explanationZh": "「も」取代「は」，表示兼提，有「也」的意思。",
    "examples": [
      {
        "ja": "グプタさんも会社員です。",
        "zh": "古普塔也是公司職員。"
      }
    ],
    "source": {
