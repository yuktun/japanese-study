  {"id":"te","japaneseName":"て形","englishName":"Te form","lesson":14,"sourceFile":"g_1_14 動詞.pdf","description":"以「て」或「で」結束的動詞活用形式。","rules":[["I組","き→いて、ぎ→いで、し→して、ち/り/い→って、び/み/に→んで","書きます → 書いて；行きます → 行って（例外）"],["II組","ます形 + て","食べます → 食べて"],["III組","ます形 + て","します → して"]]},
  {"id":"ta","japaneseName":"た形","englishName":"Ta form","lesson":19,"sourceFile":"g_1_19た.pdf","description":"以「た」或「だ」結束的動詞活用形式。","relatedNote":"Related grammar: Vた形 + ら → ～たら（第25課）","rules":[["I組","與て形相同，只將て／で改為た／だ","書きます → 書いた；行きます → 行った"],["II組","ます形 + た","食べます → 食べた"],["III組","ます形 + た","します → した"]]},
  {"id":"potential","japaneseName":"可能形","englishName":"Potential form","lesson":27,"sourceFile":"g_1_27.pdf","description":"可能動詞的作り方。","rules":[["I組","-iます → -eる","書きます → 書ける"],["II組","ます形 + られる","食べます → 食べられる"],["III組","来ます → 来られる；します → できる","します → できる"]]},
  {"id":"volitional","japaneseName":"意向形","englishName":"Volitional form","lesson":31,"sourceFile":"g_1_31.pdf","description":"「Vましょう」的普通形。","rules":[["I組","-iます → -o + う","書きます → 書こう"],["II組","ます形 + よう","食べます → 食べよう"],["III組","来ます → 来よう；します → しよう","します → しよう"]]},
  {"id":"imperative","japaneseName":"命令形","englishName":"Imperative form","lesson":33,"sourceFile":"g_1_33.pdf","description":"強行要求對方做某動作的形式；語氣很強。","rules":[["I組","-iます → -e","書きます → 書け"],["II組","ます形 + ろ","食べます → 食べろ"],["III組","来ます → 来い；します → しろ","します → しろ"]]},
  {"id":"prohibitive","japaneseName":"禁止形","englishName":"Prohibitive form","lesson":33,"sourceFile":"g_1_33.pdf","description":"命令對方不要做某動作的形式；語氣很強。","rules":[["I／II／III組","辞書形 + な","書く → 書くな；食べる → 食べるな"]]},
  {"id":"conditional","japaneseName":"条件形","englishName":"Conditional form","lesson":35,"sourceFile":"g_1_35.pdf","description":"表示條件的活用形式。","rules":[["I組","-iます → -eば","書きます → 書けば"],["II組","ます形 + れば","食べます → 食べれば"],["III組","来ます → 来れば；します → すれば","します → すれば"]]},
  {"id":"passive","japaneseName":"受身形","englishName":"Passive form","lesson":37,"sourceFile":"g_1_37.pdf","description":"受身動詞的普通形。","rules":[["I組","-iます → -aれる","書きます → 書かれる"],["II組","ます形 + られる","食べます → 食べられる"],["III組","来ます → 来られる；します → される","します → される"]]},
  {"id":"causative","japaneseName":"使役形","englishName":"Causative form","lesson":48,"sourceFile":"g_1_48使役形.pdf","description":"使役動詞的普通形。","rules":[["I組","-iます → -aせる","書きます → 書かせる"],["II組","ます形 + させる","食べます → 食べさせる"],["III組","来ます → 来させる；します → させる","します → させる"]]}
]
