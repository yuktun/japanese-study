[
  {"id":"dictionary","japaneseName":"辞書形","englishName":"Dictionary form","lesson":18,"sourceFile":"g_1_18辞書.pdf","description":"動詞的基本形式，亦即是在字典中出現的形態。","rules":[["I組","ます形最後的い段 → う段","書きます → 書く"],["II組","ます形 + る","食べます → 食べる"],["III組","来ます → 来る；します → する","来ます → 来る"]]},
